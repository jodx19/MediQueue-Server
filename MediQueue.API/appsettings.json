{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MediQueueDb;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true;",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "dev-secret-key-32-characters-minimum!!!",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "Issuer": "mediqueue-dev",
    "Audience": "mediqueue-client"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.mailtrap.io",
    "SmtpPort": 465,
    "SenderEmail": "dev@mediqueue.local",
    "SenderName": "MediQueue Dev",
    "Username": "dev-mailtrap-user",
    "Password": "dev-mailtrap-pass",
    "UseSSL": true
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "mediqueue"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "AuthPolicy": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "SeedingSettings": {
    "EnableSeeding": true
  },
  "Hangfire": {
    "DashboardUsername": "admin",
    "DashboardPassword": "admin"
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7001"
  }
}