{
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL}",
    "Redis": "${REDIS_URL}"
  },
  "JwtSettings": {
    "SecretKey": "<32+ characters random secret>",
    "Issuer": "MediQueue",
    "Audience": "MediQueueClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "<smtp.gmail.com or your SMTP server>",
    "SmtpPort": 587,
    "SenderEmail": "noreply@yourdomain.com",
    "SenderName": "MediQueue",
    "Username": "<email-username>",
    "Password": "<email-password>",
    "UseSSL": true
  },
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net",
    "ContainerName": "mediqueue-attachments"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://mediqueue-client.vercel.app"
    ]
  },
  "ApiSettings": {
    "FrontendUrl": "https://mediqueue-client.vercel.app",
    "BaseUrl": "https://mediqueue-api.onrender.com"
  },
  "Hangfire": {
    "DashboardUsername": "<hangfire-admin-username>",
    "DashboardPassword": "<hangfire-admin-password>"
  },
  "SeedingSettings": {
    "EnableSeeding": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "MediQueue": "Information"
    }
  }
}