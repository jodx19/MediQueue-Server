# Copy to .env and fill in with real values before docker-compose up

# Database
SQL_PASSWORD=YourStrongPassword@123
SQL_SA_PASSWORD=YourStrongPassword@123

# Redis
REDIS_PASSWORD=redis-password

# JWT
JWT_SECRET=your-32-character-secret-key-here!!!!

# Email
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# API
API_BASE_URL=https://mediqueue.app
CORS_ORIGINS=https://mediqueue.app,https://admin.mediqueue.app

# Hangfire Dashboard
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=strong-password-here
